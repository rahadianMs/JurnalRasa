rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SEC-01: Private user profile, bookmarks, and chat history
    // Strictly requires authenticated user matching userId. Zero cross-user leakage.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /saved_places/{placeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Public community places - read-only for public, writes restricted to authenticated users
    match /public_places/{placeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
