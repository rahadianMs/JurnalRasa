rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private user saved places - isolated per user, allowing anonymous & guest users
    match /users/{userId}/saved_places/{placeId} {
      allow read, write: if request.auth != null ? request.auth.uid == userId : true;
    }
    // Public community pulse places - readable and contribute-able by community
    match /public_places/{placeId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
